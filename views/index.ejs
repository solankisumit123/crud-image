<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/public/stylesheet/style.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <title>Document</title>
</head>
<body class="bg-zinc-900 scrollbar-hide">
    <div class="w-full h-full bg-zinc-900 p-10 text-white scrollbar-hide">
        <div class="nav mb-5">
            <a class="text-blue-500" href="/read">Go To Read Page</a>
        </div>
        <h1 class="text-3xl font-bold mb-3 ">Create User</h1>
        <form action="/create" method="post">
            <input class="px-5 py-2 bg-transparent border-2 border-zinc-800 rounded-lg outline-none " type="text"    name="name"     placeholder="name">
            <input class="px-5 py-2 bg-transparent border-2 border-zinc-800 rounded-lg outline-none " type="email"   name="email"    placeholder="email">
            <input class="px-5 py-2 bg-transparent border-2 border-zinc-800 rounded-lg outline-none " type="password" name="password" placeholder="password">
            <input class="px-5 py-2 bg-transparent border-2 border-zinc-800 rounded-lg outline-none " type="text"   name="image" placeholder="image">
            <input class="px-5 py-2 bg-blue-500 rounded-lg ml-3" type="submit" value="Creat User">
        </form>
    </div>
</body>
</html>