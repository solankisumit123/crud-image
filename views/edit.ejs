<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/public/stylesheet/style.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <title>Document</title>
</head>
<body class="bg-zinc-900">
    <div class="w-full h-full bg-zinc-900 p-10 text-white">
        <div class="nav mb-5">
            <a class="text-blue-500" href="/read">Go To Read Page</a>
        </div>
        <h1 class="text-3xl font-bold mb-3 ">update User</h1>
        <form action="/update/<%= user._id %>" method="post">
            <input class="px-5 py-2 bg-transparent border-2 border-zinc-800 rounded-lg outline-none " type="text" name="name"     placeholder="name" value="<%= user.name %>">
            <input class="px-5 py-2 bg-transparent border-2 border-zinc-800 rounded-lg outline-none " type="text" name="email"    placeholder="email" value="<%= user.email %>">
            <input class="px-5 py-2 bg-transparent border-2 border-zinc-800 rounded-lg outline-none " type="password" name="Password" placeholder="Password" value="<%= user.password %>">
            <input class="px-5 py-2 bg-transparent border-2 border-zinc-800 rounded-lg outline-none " type="text" name="image" placeholder="image" value="<%= user.image %>">
            <input class="px-5 py-2 bg-yellow-500 text-black rounded-lg ml-3" type="submit" value="update User">
        </form>
    </div>
</body>
</html>